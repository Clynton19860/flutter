{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "List emulators",
      "type": "shell",
      "command": "flutter emulators",
      "problemMatcher": []
    },
    {
      "label": "Start Android emulator",
      "type": "shell",
      "command": "flutter emulators --launch ${input:emulatorId}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "emulatorId",
      "type": "promptString",
      "description": "Emulator id from 'flutter emulators', for example Pixel_8_API_36"
    }
  ]
}
